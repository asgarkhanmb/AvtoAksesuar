<Window x:Class="PcKod.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Avto Aksesuar - Satış Sistemi"
        Height="750"
        Width="1150"
        MinHeight="700"
        MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Resources>

        <!-- ===================================================== -->
        <!-- TEMA RƏNGLƏRİ -->
        <!-- ===================================================== -->

        <SolidColorBrush x:Key="WindowBackgroundBrush"
                         Color="#F4F7FB"/>

        <SolidColorBrush x:Key="PanelBackgroundBrush"
                         Color="#FFFFFF"/>

        <SolidColorBrush x:Key="TextBrush"
                         Color="#263238"/>

        <SolidColorBrush x:Key="SecondaryTextBrush"
                         Color="#78909C"/>

        <SolidColorBrush x:Key="BorderBrushTheme"
                         Color="#D5DEE8"/>

        <SolidColorBrush x:Key="HeaderBackgroundBrush"
                         Color="#E8F1FA"/>

        <SolidColorBrush x:Key="HeaderTextBrush"
                         Color="#315A7D"/>

        <SolidColorBrush x:Key="GridLineBrush"
                         Color="#E4EAF0"/>

        <SolidColorBrush x:Key="AlternateRowBrush"
                         Color="#F8FAFD"/>

        <SolidColorBrush x:Key="HoverRowBrush"
                         Color="#EEF6FC"/>

        <SolidColorBrush x:Key="SelectedRowBrush"
                         Color="#DDEEFF"/>

        <SolidColorBrush x:Key="SelectedTextBrush"
                         Color="#1F4F73"/>

        <SolidColorBrush x:Key="InputBackgroundBrush"
                         Color="#FFFFFF"/>

        <SolidColorBrush x:Key="InputBorderBrush"
                         Color="#9CC2DF"/>

        <SolidColorBrush x:Key="TotalTextBrush"
                         Color="#2F6F9F"/>

        <!-- ÜMUMİ MƏBLƏĞ ÜÇÜN AYRI RƏNG -->
        <SolidColorBrush x:Key="TotalAmountBrush"
                         Color="#2F6F9F"/>


        <!-- ===================================================== -->
        <!-- ÜMUMİ DÜYMƏ STİLİ -->
        <!-- ===================================================== -->

        <Style TargetType="Button">

            <Setter Property="FontFamily"
                    Value="Segoe UI"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#FFFFFF"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>


        <!-- ===================================================== -->
        <!-- TEXTBOX -->
        <!-- ===================================================== -->

        <Style TargetType="TextBox">

            <Setter Property="FontFamily"
                    Value="Segoe UI"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource TextBrush}"/>

            <Setter Property="Background"
                    Value="{DynamicResource InputBackgroundBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrushTheme}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

        </Style>


        <!-- ===================================================== -->
        <!-- DATAGRID BAŞLIQ -->
        <!-- ===================================================== -->

        <Style TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                    Value="{DynamicResource HeaderBackgroundBrush}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource HeaderTextBrush}"/>

            <Setter Property="Padding"
                    Value="10,8"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrushTheme}"/>

            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>

        </Style>


        <!-- ===================================================== -->
        <!-- DATAGRID CELL -->
        <!-- ===================================================== -->

        <Style TargetType="DataGridCell">

            <Setter Property="Foreground"
                    Value="{DynamicResource TextBrush}"/>

            <Setter Property="Background"
                    Value="{DynamicResource PanelBackgroundBrush}"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="6"/>

        </Style>

    </Window.Resources>


    <Grid Margin="10">

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="2.5*"/>
            <ColumnDefinition Width="1*"/>

        </Grid.ColumnDefinitions>


        <!-- ===================================================== -->
        <!-- SATIŞ SƏBƏTİ -->
        <!-- ===================================================== -->

        <GroupBox Header="CARİ SATIŞ SƏBƏTİ"
                  Grid.Column="0"
                  Foreground="{DynamicResource HeaderTextBrush}"
                  BorderBrush="{DynamicResource BorderBrushTheme}"
                  Background="{DynamicResource PanelBackgroundBrush}"
                  Margin="5"
                  FontWeight="Bold"
                  FontSize="14">

            <DataGrid Name="dgSepet"
                      Background="{DynamicResource PanelBackgroundBrush}"
                      Foreground="{DynamicResource TextBrush}"
                      RowBackground="{DynamicResource PanelBackgroundBrush}"
                      AlternatingRowBackground="{DynamicResource AlternateRowBrush}"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource GridLineBrush}"
                      BorderThickness="0"
                      FontSize="16"
                      FontWeight="SemiBold"
                      CellEditEnding="dgSepet_CellEditEnding"
                      SelectionChanged="dgSepet_SelectionChanged_1"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False">

                <DataGrid.Resources>

                    <Style TargetType="DataGridRow">

                        <Setter Property="Background"
                                Value="{DynamicResource PanelBackgroundBrush}"/>

                        <Setter Property="Foreground"
                                Value="{DynamicResource TextBrush}"/>

                        <Setter Property="BorderThickness"
                                Value="0"/>

                        <Style.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter Property="Background"
                                        Value="{DynamicResource HoverRowBrush}"/>

                            </Trigger>

                            <Trigger Property="IsSelected"
                                     Value="True">

                                <Setter Property="Background"
                                        Value="{DynamicResource SelectedRowBrush}"/>

                                <Setter Property="Foreground"
                                        Value="{DynamicResource SelectedTextBrush}"/>

                            </Trigger>

                        </Style.Triggers>

                    </Style>

                </DataGrid.Resources>


                <DataGrid.Columns>

                    <DataGridTextColumn Header="Məhsulun adı"
                                        Binding="{Binding UrunAdi}"
                                        IsReadOnly="True"
                                        Width="2*"/>

                    <DataGridTextColumn Header="Miqdar"
                                        Binding="{Binding Miktar, UpdateSourceTrigger=PropertyChanged}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Vahid"
                                        Binding="{Binding BirimMetni}"
                                        IsReadOnly="True"
                                        Width="0.6*"/>

                    <DataGridTextColumn Header="Vahid qiyməti"
                                        Binding="{Binding BirimFiyat, StringFormat={}{0:N2} AZN}"
                                        IsReadOnly="True"
                                        Width="*"/>


                    <!-- ================================================= -->
                    <!-- ÜMUMİ MƏBLƏĞ -->
                    <!-- ================================================= -->

                    <DataGridTemplateColumn Header="Ümumi məbləğ"
                                            Width="*">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <TextBox Text=""
                                         Background="{DynamicResource InputBackgroundBrush}"
                                         Foreground="{DynamicResource TotalTextBrush}"
                                         BorderBrush="{DynamicResource BorderBrushTheme}"
                                         BorderThickness="1"
                                         Padding="5"
                                         FontSize="16"
                                         FontWeight="Bold"
                                         VerticalContentAlignment="Center"
                                         HorizontalContentAlignment="Right"
                                         HorizontalAlignment="Stretch"
                                         Loaded="txtCartTotalEditor_Loaded"
                                         LostFocus="txtCartTotalEditor_LostFocus"
                                         KeyDown="txtCartTotalEditor_KeyDown"/>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>


                    <!-- ================================================= -->
                    <!-- SİL -->
                    <!-- ================================================= -->

                    <DataGridTemplateColumn Header="Sil"
                                            Width="70">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <Button Content="❌"
                                        Width="42"
                                        Height="30"
                                        Background="#E57373"
                                        Foreground="White"
                                        BorderThickness="0"
                                        FontWeight="Bold"
                                        Cursor="Hand"
                                        ToolTip="Məhsulu səbətdən sil"
                                        Click="btnSebetdenSil_Click"/>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </GroupBox>


        <!-- ===================================================== -->
        <!-- SAĞ PANEL -->
        <!-- ===================================================== -->

        <Grid Grid.Column="1"
              Margin="10,5,10,5">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- YUXARI DÜYMƏLƏR -->
            <!-- ================================================= -->

            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,0,0,8">

                <Button Name="btnGunlukSatislar"
                        Content="🧾 SATIŞLAR"
                        Width="137"
                        Height="35"
                        Background="#5B8DB8"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Click="btnGunlukSatislar_Click"
                        Cursor="Hand"
                        Margin="0,0,8,0"/>

                <Button x:Name="btnLogin"
                        Content="🔐 DAXİL OL"
                        Width="101"
                        Height="35"
                        Background="#6C7A89"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Click="btnLogin_Click"
                        Cursor="Hand"/>

                <Button x:Name="btnTema"
                        Content="🌙"
                        Width="45"
                        Height="35"
                        Background="#455A64"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="18"
                        FontWeight="Bold"
                        Click="btnTema_Click"
                        Cursor="Hand"
                        Margin="8,0,0,0"
                        ToolTip="Gecə rejiminə keç"/>

            </StackPanel>


            <!-- ================================================= -->
            <!-- SAĞ PANEL -->
            <!-- ================================================= -->

            <StackPanel Grid.Row="1">


                <!-- ================================================= -->
                <!-- ÜMUMİ MƏBLƏĞ -->
                <!-- ================================================= -->

                <Border Background="{DynamicResource PanelBackgroundBrush}"
                        CornerRadius="10"
                        Padding="10"
                        Margin="0,0,0,8"
                        BorderBrush="{DynamicResource BorderBrushTheme}"
                        BorderThickness="1">

                    <StackPanel HorizontalAlignment="Center">

                        <TextBlock Text="ÜMUMİ MƏBLƏĞ"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>

                        <!-- GECƏ REJİMİNDƏ YAŞIL -->
                        <TextBox Name="txtGenelToplam"
                                 Text="0.00 AZN"
                                 Foreground="{DynamicResource TotalAmountBrush}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="34"
                                 FontWeight="Bold"
                                 Height="50"
                                 Width="300"
                                 HorizontalAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 HorizontalContentAlignment="Center"
                                 TextAlignment="Center"
                                 GotFocus="txtGenelToplam_GotFocus"
                                 LostFocus="txtGenelToplam_LostFocus"/>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- BARKOD -->
                <!-- ================================================= -->

                <TextBox Name="txtBarkodOkuyucu"
                         Height="45"
                         Background="{DynamicResource InputBackgroundBrush}"
                         Foreground="{DynamicResource TextBrush}"
                         BorderBrush="{DynamicResource InputBorderBrush}"
                         Padding="10"
                         FontSize="20"
                         VerticalContentAlignment="Center"
                         KeyDown="txtBarkodOkuyucu_KeyDown"
                         Margin="0,0,0,8"
                         TextChanged="txtBarkodOkuyucu_TextChanged"/>


                <!-- ================================================= -->
                <!-- ÖDƏNİŞ -->
                <!-- ================================================= -->

                <Grid Margin="0,0,0,8">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <Button Name="btnNakit"
                            Grid.Column="0"
                            Height="65"
                            Background="#4CAF7A"
                            Foreground="White"
                            BorderThickness="0"
                            Click="btnNakit_Click"
                            Cursor="Hand">

                        <StackPanel>

                            <TextBlock Text="💵 NƏĞD"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="Satışı tamamla"
                                       Foreground="White"
                                       FontSize="9"
                                       HorizontalAlignment="Center"/>

                        </StackPanel>

                    </Button>


                    <Button Name="btnKart"
                            Grid.Column="2"
                            Height="65"
                            Background="#4F8DBB"
                            Foreground="White"
                            BorderThickness="0"
                            Click="btnKart_Click"
                            Cursor="Hand">

                        <StackPanel>

                            <TextBlock Text="💳 KART"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="Satışı tamamla"
                                       Foreground="White"
                                       FontSize="9"
                                       HorizontalAlignment="Center"/>

                        </StackPanel>

                    </Button>

                </Grid>


                <!-- ================================================= -->
                <!-- GERİ QAYTARMA + HESABATLAR -->
                <!-- ================================================= -->

                <Grid Margin="0,0,0,8">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <Button Name="btnGeriQaytarma"
                            Grid.Column="0"
                            Content="↩ GERİ QAYTARMA"
                            Height="42"
                            Background="#D89A55"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"
                            Click="btnGeriQaytarma_Click"
                            Cursor="Hand"/>


                    <Button Name="btnHesabatlar"
                            Grid.Column="2"
                            Content="📈 HESABATLAR"
                            Height="42"
                            Background="#7D6B9D"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"
                            Click="btnHesabatlar_Click"
                            Cursor="Hand"/>

                </Grid>


                <!-- ================================================= -->
                <!-- BARKODSUZ / ƏL İLƏ MƏHSUL SATIŞI -->
                <!-- ================================================= -->

                <Border Background="{DynamicResource PanelBackgroundBrush}"
                        CornerRadius="6"
                        Padding="8"
                        Margin="0,0,0,8"
                        BorderBrush="{DynamicResource BorderBrushTheme}"
                        BorderThickness="1">

                    <StackPanel>

                        <TextBlock Text="Barkodsuz / Əl ilə məhsul satışı"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5"/>

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <Grid Grid.Column="0"
                                  Margin="0,0,5,0">

                                <TextBox Name="txtManuelUrunAdi"
                                         Background="{DynamicResource InputBackgroundBrush}"
                                         Foreground="{DynamicResource TextBrush}"
                                         Padding="8"
                                         BorderBrush="{DynamicResource BorderBrushTheme}"
                                         FontSize="13"
                                         Height="35"
                                         VerticalContentAlignment="Center"/>

                                <TextBlock Text="Məhsul adı"
                                           Foreground="#9AA7B2"
                                           FontSize="13"
                                           Margin="8,0,8,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">

                                    <TextBlock.Style>

                                        <Style TargetType="TextBlock">

                                            <Setter Property="Visibility"
                                                    Value="Collapsed"/>

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding Text, ElementName=txtManuelUrunAdi}"
                                                             Value="">

                                                    <Setter Property="Visibility"
                                                            Value="Visible"/>

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </TextBlock.Style>

                                </TextBlock>

                            </Grid>


                            <Grid Grid.Column="1"
                                  Margin="0,0,5,0">

                                <TextBox Name="txtManuelFiyat"
                                         Background="{DynamicResource InputBackgroundBrush}"
                                         Foreground="{DynamicResource TextBrush}"
                                         Padding="8"
                                         BorderBrush="{DynamicResource BorderBrushTheme}"
                                         FontSize="13"
                                         Height="35"
                                         VerticalContentAlignment="Center"/>

                                <TextBlock Text="Məbləğ"
                                           Foreground="#9AA7B2"
                                           FontSize="13"
                                           Margin="8,0,8,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">

                                    <TextBlock.Style>

                                        <Style TargetType="TextBlock">

                                            <Setter Property="Visibility"
                                                    Value="Collapsed"/>

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding Text, ElementName=txtManuelFiyat}"
                                                             Value="">

                                                    <Setter Property="Visibility"
                                                            Value="Visible"/>

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </TextBlock.Style>

                                </TextBlock>

                            </Grid>


                            <Button Name="btnManuelEkle"
                                    Grid.Column="2"
                                    Content="ƏLAVƏ ET"
                                    Height="35"
                                    MinWidth="85"
                                    Background="#4CAF7A"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontWeight="Bold"
                                    Padding="10,0"
                                    Click="btnManuelEkle_Click"
                                    Cursor="Hand"/>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- XİDMƏTLƏR -->
                <!-- ================================================= -->

                <Button Name="btnXidmetler"
                        Content="🛠 XİDMƏTLƏR"
                        Height="42"
                        Margin="0,0,0,6"
                        Background="#4E9A91"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="14"
                        Click="btnXidmetler_Click"
                        Cursor="Hand"/>


                <!-- ================================================= -->
                <!-- MƏHSULLAR -->
                <!-- ================================================= -->

                <Button Name="btnUrunListesi"
                        Content="📦 MƏHSULLARIN İDARƏ EDİLMƏSİ"
                        Height="38"
                        Margin="0,0,0,6"
                        Background="#66788A"
                        Foreground="White"
                        BorderThickness="0"
                        Click="btnUrunListesi_Click"
                        Cursor="Hand"/>


                <!-- ================================================= -->
                <!-- ANBAR -->
                <!-- ================================================= -->

                <Button Name="btnStokSayfasi"
                        Content="📋 ANBAR QALIĞI"
                        Height="38"
                        Margin="0,0,0,6"
                        Background="#7A82A8"
                        Foreground="White"
                        BorderThickness="0"
                        Click="btnStokSayfasi_Click"
                        Cursor="Hand"/>


                <!-- ================================================= -->
                <!-- TOPDAN SATIŞ -->
                <!-- ================================================= -->

                <Button Name="btnToptanSatis"
                        Content="TOPDAN SATIŞ"
                        Height="42"
                        Margin="0,0,0,6"
                        Background="#C9824E"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Click="btnToptanSatis_Click"
                        Cursor="Hand"/>


                <!-- ================================================= -->
                <!-- SƏBƏTİ BOŞALT -->
                <!-- ================================================= -->

                <Button Name="btnSepetiTemizle"
                        Content="❌ SƏBƏTİ BOŞALT"
                        Height="38"
                        Background="#D46A6A"
                        Foreground="White"
                        BorderThickness="0"
                        Click="btnSepetiTemizle_Click"
                        Cursor="Hand"/>


                <!-- ================================================= -->
                <!-- İSTİFADƏÇİ MƏLUMATLARI -->
                <!-- ================================================= -->

                <Border Background="{DynamicResource PanelBackgroundBrush}"
                        CornerRadius="8"
                        Padding="2"
                        Margin="0,10,0,0"
                        BorderBrush="{DynamicResource BorderBrushTheme}"
                        BorderThickness="1"
                        Height="79">

                    <StackPanel HorizontalAlignment="Center">

                        <TextBlock Text="Hazırladı"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="10"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Əsgərxan Bayramov"
                                   Foreground="{DynamicResource TotalTextBrush}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Margin="0,3,0,0"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="+994 51 584 64 11"
                                   Foreground="#D46A6A"
                                   FontSize="12"
                                   Margin="0,3,0,0"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>

                </Border>

            </StackPanel>

        </Grid>

    </Grid>

</Window>