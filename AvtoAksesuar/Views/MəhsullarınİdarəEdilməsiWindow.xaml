<Window x:Class="PcKod.UI.Views.UrunListesiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Məhsulların İdarə Edilməsi"
        Height="700"
        Width="1150"
        MinHeight="600"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9">

    <Window.Resources>

        <!-- ÜMUMİ MƏTN -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#344054"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- TEXTBOX -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#263238"/>
            <Setter Property="CaretBrush" Value="#2E7D32"/>
            <Setter Property="SelectionBrush" Value="#A5D6A7"/>
            <Setter Property="SelectionTextBrush" Value="#263238"/>
            <Setter Property="BorderBrush" Value="#D0D5DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="AcceptsReturn" Value="False"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Hidden"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        </Style>

        <!-- YAŞIL DÜYMƏ -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1B5E20"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#145218"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CƏDVƏL MƏTNİ MƏRKƏZDƏ -->
        <Style x:Key="CenterTextStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Foreground" Value="#263238"/>
        </Style>

        <!-- CƏDVƏL XANALARI -->
        <Style x:Key="ProductCellStyle"
               TargetType="{x:Type DataGridCell}">
            <Setter Property="Foreground" Value="#263238"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#C8E6C9"/>
                    <Setter Property="Foreground" Value="#1B5E20"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- SÜTUN BAŞLIQLARI -->
        <Style x:Key="ProductHeaderStyle"
               TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#E8F5E9"/>
            <Setter Property="Foreground" Value="#1B5E20"/>
            <Setter Property="Padding" Value="6,10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#DDE2E8"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <!-- CƏDVƏL SƏTRLƏRİ -->
        <Style x:Key="ProductRowStyle"
               TargetType="{x:Type DataGridRow}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#263238"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E8F5E9"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#C8E6C9"/>
                    <Setter Property="Foreground" Value="#1B5E20"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- QIRMIZI SİLMƏ DÜYMƏSİ -->
        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#D92D20"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DangerBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="8">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DangerBorder"
                                        Property="Background"
                                        Value="#B42318"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="DangerBorder"
                                        Property="Background"
                                        Value="#912018"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- SOL TƏRƏF: MƏHSULLAR -->
        <Grid Grid.Column="0" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ANA SƏHİFƏYƏ QAYIT -->
            <Button Grid.Row="0"
                    Content="← ANA SƏHİFƏYƏ QAYIT"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    Foreground="#667085"
                    BorderThickness="0"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Click="btnGeri_Click"
                    Cursor="Hand"
                    Padding="0,5"
                    Margin="0,0,0,15"/>

            <!-- AXTARIŞ PANELİ -->
            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#DDE2E8"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="15"
                    Margin="0,0,0,15">

                <StackPanel>
                    <TextBlock Text="Məhsul və ya barkod üzrə axtarış"
                               Foreground="#344054"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <TextBox Name="txtHizliAra"
                             Style="{StaticResource InputStyle}"
                             Height="42"
                             ToolTip="Məhsulun adını və ya barkodunu daxil edin"
                             TextChanged="txtHizliAra_TextChanged"/>
                </StackPanel>
            </Border>

            <!-- MƏHSULLAR CƏDVƏLİ -->
            <Border Grid.Row="2"
                    Background="White"
                    BorderBrush="#DDE2E8"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="1">

                <DataGrid Name="dgUrunler"
                          AutoGenerateColumns="False"
                          Background="White"
                          RowBackground="White"
                          AlternatingRowBackground="#F8FAFC"
                          Foreground="#263238"
                          SelectionChanged="dgUrunler_SelectionChanged"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EAECF0"
                          BorderThickness="0"
                          RowHeight="42"
                          ColumnHeaderHeight="44"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          RowStyle="{StaticResource ProductRowStyle}"
                          CellStyle="{StaticResource ProductCellStyle}"
                          ColumnHeaderStyle="{StaticResource ProductHeaderStyle}">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Barkod"
                                            Binding="{Binding Barkod}"
                                            Width="110"
                                            ElementStyle="{StaticResource CenterTextStyle}"/>

                        <DataGridTextColumn Header="Məhsulun adı"
                                            Binding="{Binding MəhsulAdi}"
                                            Width="*"
                                            MinWidth="120"
                                            ElementStyle="{StaticResource CenterTextStyle}"/>

                        <DataGridTextColumn Header="Ölçü vahidi"
                                            Binding="{Binding VahidMetni}"
                                            Width="100"
                                            ElementStyle="{StaticResource CenterTextStyle}"/>

                        <DataGridTextColumn Header="Alış qiyməti"
                                            Binding="{Binding AlisQiymeti, StringFormat={}{0:N2} ₼}"
                                            Width="110"
                                            ElementStyle="{StaticResource CenterTextStyle}"/>

                        <DataGridTextColumn Header="Satış qiyməti"
                                            Binding="{Binding SatisQiymeti, StringFormat={}{0:N2} ₼}"
                                            Width="110"
                                            ElementStyle="{StaticResource CenterTextStyle}"/>

                        <DataGridTextColumn Header="Stok sayı"
                                            Binding="{Binding StokMiqdar}"
                                            Width="90"
                                            ElementStyle="{StaticResource CenterTextStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- SAĞ TƏRƏF: MƏHSUL ƏMƏLİYYATLARI -->
        <Border Grid.Column="1"
                Margin="10,20,20,20"
                Background="White"
                BorderBrush="#DDE2E8"
                BorderThickness="1"
                CornerRadius="10">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel Margin="20">

                    <!-- BAŞLIQ -->
                    <TextBlock Text="Məhsul əməliyyatları"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#263238"
                               Margin="0,0,0,6"/>

                    <TextBlock Text="Məhsul əlavə edin və ya məlumatlarını yeniləyin"
                               FontSize="12"
                               Foreground="#667085"
                               TextWrapping="Wrap"
                               Margin="0,0,0,22"/>

                    <!-- BARKOD -->
                    <TextBlock Text="Barkod nömrəsi"
                               Style="{StaticResource LabelStyle}"
                               Margin="0,0,0,6"/>

                    <TextBox Name="txtBarkod"
                             Style="{StaticResource InputStyle}"
                             Margin="0,0,0,15"/>

                    <!-- MƏHSUL ADI -->
                    <TextBlock Text="Məhsulun adı"
                               Style="{StaticResource LabelStyle}"
                               Margin="0,0,0,6"/>

                    <TextBox Name="txtUrunAdi"
                             Style="{StaticResource InputStyle}"
                             Margin="0,0,0,15"/>

                    <!-- QİYMƏTLƏR -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Alış qiyməti"
                                       Style="{StaticResource LabelStyle}"
                                       Margin="0,0,0,6"/>

                            <TextBox Name="txtAlisFiyati"
                                     Style="{StaticResource InputStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Satış qiyməti"
                                       Style="{StaticResource LabelStyle}"
                                       Margin="0,0,0,6"/>

                            <TextBox Name="txtSatisFiyati"
                                     Style="{StaticResource InputStyle}"/>
                        </StackPanel>
                    </Grid>

                    <!-- STOK SAYI -->
                    <TextBlock Text="Məhsul sayı"
                               Style="{StaticResource LabelStyle}"
                               Margin="0,0,0,6"/>

                    <TextBox Name="txtStokMiktari"
                             Style="{StaticResource InputStyle}"
                             Margin="0,0,0,15"
                             PreviewTextInput="txtStokMiktari_PreviewTextInput"/>

                    <!-- ÖLÇÜ VAHİDİ -->
                    <TextBlock Text="Satış ölçü vahidi"
                               Style="{StaticResource LabelStyle}"
                               Margin="0,0,0,6"/>

                    <ComboBox Name="cmbBirim"
                              Height="40"
                              Background="White"
                              Foreground="#263238"
                              BorderBrush="#D0D5DD"
                              BorderThickness="1"
                              Padding="8,5"
                              FontSize="14"
                              SelectedIndex="0"
                              Margin="0,0,0,22">

                        <ComboBoxItem Content="Ədəd"/>
                        <ComboBoxItem Content="Kq"/>
                    </ComboBox>

                    <!-- YADDA SAXLA / YENİLƏ -->
                    <Button Name="btnKaydet"
                            Content="YADDA SAXLA / YENİLƏ"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="46"
                            Click="btnKaydet_Click"/>

                    <!-- MƏHSULU SİL -->
                    <Button Name="btnSilIlk"
                            Content="MƏHSULU SİL"
                            Style="{StaticResource DangerButtonStyle}"
                            Height="40"
                            Margin="0,12,0,0"
                            Click="btnSilIlk_Click"/>

                    <!-- SİLMƏ TƏSDİQİ -->
                    <StackPanel Name="pnlSilOnay"
                                Visibility="Collapsed"
                                Margin="0,15,0,0">

                        <Border Background="#FEF3F2"
                                BorderBrush="#FECDCA"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12">

                            <StackPanel>
                                <TextBlock Text="Məhsulun silinməsi"
                                           Foreground="#B42318"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Margin="0,0,0,8"/>

                                <TextBlock Text="Məhsulu silmək üçün şifrəni daxil edin:"
                                           Foreground="#344054"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8"/>

                                <PasswordBox Name="txtSilSifre"
                                             Background="White"
                                             Foreground="#263238"
                                             BorderBrush="#D0D5DD"
                                             BorderThickness="1"
                                             Padding="8"
                                             Height="38"/>

                                <Button Content="SİLMƏNİ TƏSDİQLƏ"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Click="btnSilOnay_Click"
                                        Margin="0,10,0,0"
                                        Height="38"/>

                                <Button Content="Ləğv et"
                                        Background="Transparent"
                                        Foreground="#667085"
                                        BorderThickness="0"
                                        Click="btnSilIptal_Click"
                                        Height="34"
                                        Margin="0,4,0,0"
                                        Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
