<Window x:Class="PcKod.UI.Views.XidmetlerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xidmət Satışı"
        Height="400"
        Width="700"
        MinHeight="350"
        MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="#121212">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- BAŞLIQ -->
        <!-- ===================================================== -->

        <Border Grid.Row="0"
                Background="#1E1E1E"
                BorderBrush="#00FF41"
                BorderThickness="1"
                CornerRadius="8"
                Padding="15"
                Margin="0,0,0,25">

            <StackPanel>

                <TextBlock Text="🛠 XİDMƏT SATIŞI"
                           Foreground="#00FF41"
                           FontSize="24"
                           FontWeight="Bold"/>

                <TextBlock Text="Xidmətin adını və məbləğini daxil edin"
                           Foreground="#AAAAAA"
                           FontSize="13"
                           Margin="0,5,0,0"/>

            </StackPanel>

        </Border>


        <!-- ===================================================== -->
        <!-- MƏLUMATLAR -->
        <!-- ===================================================== -->

        <Grid Grid.Row="1"
              VerticalAlignment="Center">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="20"/>

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <!-- XİDMƏTİN ADI -->

            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="160"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <TextBlock Grid.Column="0"
                           Text="Xidmətin adı:"
                           Foreground="White"
                           FontSize="17"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>


                <TextBox Name="txtXidmetAdi"
                         Grid.Column="1"
                         Height="48"
                         Background="#252525"
                         Foreground="White"
                         BorderBrush="#555555"
                         FontSize="17"
                         Padding="12"
                         VerticalContentAlignment="Center"
                         ToolTip="Xidmətin adını yazın"/>

            </Grid>


            <!-- MƏBLƏĞ -->

            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="160"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <TextBlock Grid.Column="0"
                           Text="Məbləğ:"
                           Foreground="White"
                           FontSize="17"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>


                <TextBox Name="txtMebleg"
                         Grid.Column="1"
                         Height="48"
                         Background="#252525"
                         Foreground="White"
                         BorderBrush="#555555"
                         FontSize="17"
                         Padding="12"
                         VerticalContentAlignment="Center"
                         ToolTip="Məbləği daxil edin"/>


                <TextBlock Grid.Column="2"
                           Text=" AZN"
                           Foreground="#00FF41"
                           FontSize="17"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"/>

            </Grid>

        </Grid>


        <!-- ===================================================== -->
        <!-- SATIŞA VUR -->
        <!-- ===================================================== -->

        <Button Grid.Row="2"
                Name="btnSatisaVur"
                Content="💰 SATIŞI BİTİR"
                Height="55"
                Background="#27AE60"
                Foreground="White"
                BorderThickness="0"
                FontSize="18"
                FontWeight="Bold"
                Click="btnSatisaVur_Click"
                Cursor="Hand"/>

    </Grid>

</Window>