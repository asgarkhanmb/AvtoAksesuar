<Window x:Class="PcKod.UI.Views.XidmetlerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xidmət Satışı"
        Height="400"
        Width="700"
        MinHeight="350"
        MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- BAŞLIQ -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#DDE2E8"
                BorderThickness="1"
                CornerRadius="8"
                Padding="15"
                Margin="0,0,0,25">

            <StackPanel>

                <TextBlock Text="XİDMƏT SATIŞI"
                           Foreground="#2E7D32"
                           FontSize="24"
                           FontWeight="Bold"/>

                <TextBlock Text="Xidmətin adını və məbləğini daxil edin"
                           Foreground="#667085"
                           FontSize="13"
                           Margin="0,5,0,0"/>

            </StackPanel>

        </Border>

        <!-- MƏLUMATLAR -->
        <Grid Grid.Row="1"
              VerticalAlignment="Center">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- XİDMƏTİN ADI -->
            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Xidmətin adı:"
                           Foreground="#263238"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <TextBox Name="txtXidmetAdi"
                         Grid.Column="1"
                         Height="48"
                         Background="White"
                         Foreground="#263238"
                         BorderBrush="#D0D5DD"
                         BorderThickness="1"
                         FontSize="16"
                         Padding="12"
                         VerticalContentAlignment="Center"
                         ToolTip="Xidmətin adını yazın"/>

            </Grid>

            <!-- MƏBLƏĞ -->
            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Məbləğ:"
                           Foreground="#263238"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <TextBox Name="txtMebleg"
                         Grid.Column="1"
                         Height="48"
                         Background="White"
                         Foreground="#263238"
                         BorderBrush="#D0D5DD"
                         BorderThickness="1"
                         FontSize="16"
                         Padding="12"
                         VerticalContentAlignment="Center"
                         ToolTip="Məbləği daxil edin"/>

                <TextBlock Grid.Column="2"
                           Text=" AZN"
                           Foreground="#2E7D32"
                           FontSize="17"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"/>

            </Grid>

        </Grid>

        <!-- SATIŞI BİTİR -->
        <Button Grid.Row="2"
                Name="btnSatisaVur"
                Content="SATIŞI BİTİR"
                Height="55"
                Background="#2E7D32"
                Foreground="White"
                BorderThickness="0"
                FontSize="17"
                FontWeight="Bold"
                Click="btnSatisaVur_Click"
                Cursor="Hand">

            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#2E7D32"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FontSize" Value="17"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Cursor" Value="Hand"/>

                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#1B5E20"/>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#145218"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>

        </Button>

    </Grid>

</Window>
