<Window x:Class="PcKod.UI.Views.StokSayfasi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anbar Qalığı və Yenilənməsi"
        Height="650"
        Width="1000"
        MinHeight="550"
        MinWidth="900"
        Background="#F4F6F9"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- AXTARIŞ VƏ DAXİL ETMƏ SAHƏLƏRİ -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#263238"/>
            <Setter Property="CaretBrush" Value="#2E7D32"/>
            <Setter Property="BorderBrush" Value="#D0D5DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SelectionBrush" Value="#A5D6A7"/>
            <Setter Property="SelectionTextBrush" Value="#263238"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Stretch"
                                          Focusable="False"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder"
                                        Property="BorderBrush"
                                        Value="#2E7D32"/>
                                <Setter TargetName="InputBorder"
                                        Property="BorderThickness"
                                        Value="1.5"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder"
                                        Property="Opacity"
                                        Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CƏDVƏL MƏTNİ -->
        <Style x:Key="CenterTextStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Foreground" Value="#263238"/>
        </Style>

        <!-- CƏDVƏL BAŞLIQLARI -->
        <Style x:Key="StockHeaderStyle"
               TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#E8F5E9"/>
            <Setter Property="Foreground" Value="#1B5E20"/>
            <Setter Property="Padding" Value="6,10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#DDE2E8"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <!-- CƏDVƏL XANALARI -->
        <Style x:Key="StockCellStyle"
               TargetType="{x:Type DataGridCell}">
            <Setter Property="Foreground" Value="#263238"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#C8E6C9"/>
                    <Setter Property="Foreground" Value="#1B5E20"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- CƏDVƏL SƏTRLƏRİ -->
        <Style x:Key="StockRowStyle"
               TargetType="{x:Type DataGridRow}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#263238"/>
            <Setter Property="MinHeight" Value="42"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E8F5E9"/>
                </Trigger>

                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#C8E6C9"/>
                    <Setter Property="Foreground" Value="#1B5E20"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ƏSAS YAŞIL DÜYMƏ -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="10">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1B5E20"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#145218"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- SOL TƏRƏF: ANBAR SİYAHISI -->
        <Grid Grid.Column="0" Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- BAŞLIQ -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#DDE2E8"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="15"
                    Margin="0,0,0,15">

                <StackPanel>
                    <TextBlock Text="ANBAR QALIĞI"
                               Foreground="#2E7D32"
                               FontSize="24"
                               FontWeight="Bold"/>

                    <TextBlock Text="Məhsulların cari qalıq miqdarına nəzarət"
                               Foreground="#667085"
                               FontSize="12"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- AXTARIŞ -->
            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#DDE2E8"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14"
                    Margin="0,0,0,12">

                <StackPanel>
                    <TextBlock Text="Məhsul və ya barkod üzrə axtarış"
                               Foreground="#344054"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="0,0,0,7"/>

                    <TextBox Name="txtStokAra"
                             Style="{StaticResource InputStyle}"
                             TextChanged="txtStokAra_TextChanged"
                             ToolTip="Məhsulun adını və ya barkodunu daxil edin"/>
                </StackPanel>
            </Border>

            <!-- ANBAR CƏDVƏLİ -->
            <Border Grid.Row="2"
                    Background="White"
                    BorderBrush="#DDE2E8"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="1">

                <DataGrid Name="dgStok"
                          Background="White"
                          Foreground="#263238"
                          RowBackground="White"
                          AlternatingRowBackground="#F8FAFC"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EAECF0"
                          BorderThickness="0"
                          FontSize="13"
                          RowHeight="42"
                          ColumnHeaderHeight="44"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          SelectionChanged="dgStok_SelectionChanged"
                          RowStyle="{StaticResource StockRowStyle}"
                          CellStyle="{StaticResource StockCellStyle}"
                          ColumnHeaderStyle="{StaticResource StockHeaderStyle}">

                    <DataGrid.Columns>

                        <!-- BARKOD -->
                        <DataGridTextColumn Header="Barkod"
                                            Binding="{Binding Barkod}"
                                            Width="120"
                                            ElementStyle="{StaticResource CenterTextStyle}"/>

                        <!-- MƏHSULUN ADI -->
                        <DataGridTextColumn Header="Məhsulun adı"
                                            Binding="{Binding UrunAdi}"
                                            Width="2*"
                                            MinWidth="120"
                                            ElementStyle="{StaticResource CenterTextStyle}"/>

                        <!-- QALIQ MİQDARI -->
                        <DataGridTextColumn Header="Qalıq miqdarı"
                                            Binding="{Binding StokMiktari}"
                                            Width="1*"
                                            MinWidth="100"
                                            ElementStyle="{StaticResource CenterTextStyle}"/>

                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- SAĞ TƏRƏF: ANBARA MƏDAXİL -->
        <Border Grid.Column="1"
                Margin="10,20,20,20"
                Background="White"
                BorderBrush="#DDE2E8"
                BorderThickness="1"
                CornerRadius="10">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel Margin="18">

                    <!-- BAŞLIQ -->
                    <TextBlock Text="Anbara mədaxil"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#263238"
                               Margin="0,0,0,5"/>

                    <TextBlock Text="Seçilmiş məhsulun stok miqdarını artırın"
                               FontSize="12"
                               Foreground="#667085"
                               TextWrapping="Wrap"
                               Margin="0,0,0,22"/>

                    <!-- SEÇİLMİŞ MƏHSUL -->
                    <TextBlock Text="Seçilmiş məhsul"
                               Foreground="#344054"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <TextBox Name="txtSeciliUrun"
                             Style="{StaticResource InputStyle}"
                             Background="#F0FDF4"
                             Foreground="#1B5E20"
                             BorderBrush="#BBF7D0"
                             IsReadOnly="True"
                             FontWeight="Bold"
                             Margin="0,0,0,16"/>

                    <!-- MÖVCUD QALIQ -->
                    <TextBlock Text="Mövcud qalıq"
                               Foreground="#344054"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <TextBox Name="txtMevcutStok"
                             Style="{StaticResource InputStyle}"
                             Background="#F8FAFC"
                             IsReadOnly="True"
                             Margin="0,0,0,20"/>

                    <!-- ƏLAVƏ EDİLƏCƏK MİQDAR -->
                    <Border Background="#F0FDF4"
                            BorderBrush="#BBF7D0"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,8">

                        <StackPanel>
                            <TextBlock Text="Daxil olan mal"
                                       Foreground="#1B5E20"
                                       FontSize="14"
                                       FontWeight="Bold"/>

                            <TextBlock Text="Anbara əlavə ediləcək miqdarı daxil edin (+)"
                                       Foreground="#475467"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBox Name="txtYeniStok"
                             Style="{StaticResource InputStyle}"
                             Height="48"
                             FontSize="16"
                             BorderBrush="#86C98A"
                             Margin="0,0,0,22"
                             ToolTip="Əlavə ediləcək məhsul miqdarını daxil edin"/>

                    <!-- ANBARA ƏLAVƏ ET -->
                    <Button Name="btnStokGuncelle"
                            Content="ANBARA ƏLAVƏ ET"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="50"
                            Click="btnStokGuncelle_Click"/>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
