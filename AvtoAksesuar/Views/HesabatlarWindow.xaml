<Window x:Class="PcKod.UI.Views.HesabatlarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hesabatlar - SatisSistemi"
        Height="750"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="White">

    <Window.Resources>

        <!-- DATEPICKER -->
        <Style TargetType="DatePicker">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- DATEPICKER TEXTBOX -->
        <Style TargetType="DatePickerTextBox">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="40"/>
        </Style>

        <!-- COMBOBOX -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="42"/>
        </Style>

        <!-- COMBOBOX ITEM -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

    </Window.Resources>

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- BAŞLIQ -->
        <Grid Grid.Row="0"
              Margin="0,0,0,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="📈 SATIŞ HESABATLARI"
                           Foreground="Black"
                           FontSize="28"
                           FontWeight="Bold"/>

                <TextBlock Text="Satış məlumatlarını tarix və ödəniş növünə görə analiz edin"
                           Foreground="#555555"
                           FontSize="13"
                           Margin="0,5,0,0"/>

            </StackPanel>

            <Button Grid.Column="1"
                    Name="btnGeri"
                    Content="← GERİ QAYIT"
                    Width="130"
                    Height="40"
                    Background="#333333"
                    Foreground="White"
                    BorderBrush="#555555"
                    Click="btnGeri_Click"/>

        </Grid>

        <!-- FILTER -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#D0D0D0"
                BorderThickness="1"
                CornerRadius="8"
                Padding="15"
                Margin="0,0,0,15">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="165"/>
                    <ColumnDefinition Width="25"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="165"/>
                    <ColumnDefinition Width="25"/>
                    <ColumnDefinition Width="165"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="165"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- BAŞLANĞIC TARİXİ -->
                <TextBlock Grid.Column="0"
                           Text="Başlanğıc:"
                           Foreground="#333333"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <DatePicker Grid.Column="1"
                            Name="dpBaslangic"
                            Height="42"/>

                <!-- BİTİŞ TARİXİ -->
                <TextBlock Grid.Column="3"
                           Text="Bitmə:"
                           Foreground="#333333"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <DatePicker Grid.Column="4"
                            Name="dpBitis"
                            Height="42"/>

                <!-- ÖDƏNİŞ NÖVÜ -->
                <ComboBox Grid.Column="6"
                          Name="cmbOdemeTipi"
                          Height="42"
                          SelectedIndex="0"
                          VerticalContentAlignment="Center">

                    <ComboBoxItem Content="Bütün ödənişlər"/>
                    <ComboBoxItem Content="Nəğd"/>
                    <ComboBoxItem Content="Kart"/>

                </ComboBox>

                <!-- HESABATI GÖSTƏR -->
                <Button Grid.Column="8"
                        Name="btnHesabatGoster"
                        Content="🔎 HESABATI GÖSTƏR"
                        Height="42"
                        Background="#2980B9"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="btnHesabatGoster_Click"/>

                <!-- EXCEL -->
                <Button Grid.Column="10"
                        Name="btnExcel"
                        Content="📊 EXCEL"
                        Width="100"
                        Height="42"
                        Background="#218838"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="btnExcel_Click"/>

            </Grid>

        </Border>

        <!-- ƏSAS HİSSƏ -->
        <Grid Grid.Row="2">

            <Grid.RowDefinitions>
                <RowDefinition Height="130"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- STATİSTİKA KARTLARI -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,15">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ÜMUMİ SATIŞ -->
                <Border Grid.Column="0"
                        Background="White"
                        BorderBrush="#2E7D32"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="15">

                    <StackPanel>

                        <TextBlock Text="💰 ÜMUMİ SATIŞ"
                                   Foreground="#555555"
                                   FontSize="13"/>

                        <TextBlock Name="txtUmumiSatis"
                                   Text="0.00 ₼"
                                   Foreground="#2E7D32"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>

                <!-- NƏĞD SATIŞ -->
                <Border Grid.Column="2"
                        Background="White"
                        BorderBrush="#28A745"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="15">

                    <StackPanel>

                        <TextBlock Text="💵 NƏĞD SATIŞ"
                                   Foreground="#555555"
                                   FontSize="13"/>

                        <TextBlock Name="txtNagdSatis"
                                   Text="0.00 ₼"
                                   Foreground="#28A745"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>

                <!-- KART SATIŞI -->
                <Border Grid.Column="4"
                        Background="White"
                        BorderBrush="#2980B9"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="15">

                    <StackPanel>

                        <TextBlock Text="💳 KART SATIŞI"
                                   Foreground="#555555"
                                   FontSize="13"/>

                        <TextBlock Name="txtKartSatis"
                                   Text="0.00 ₼"
                                   Foreground="#2980B9"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>

                <!-- XALİS GƏLİR -->
                <Border Grid.Column="6"
                        Background="White"
                        BorderBrush="#9B59B6"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="15">

                    <StackPanel>

                        <TextBlock Text="📈 XALİS GƏLİR"
                                   Foreground="#555555"
                                   FontSize="13"/>

                        <TextBlock Name="txtXalisGelir"
                                   Text="0.00 ₼"
                                   Foreground="#9B59B6"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>

                <!-- XİDMƏT SATIŞI -->
                <Border Grid.Column="8"
                        Background="White"
                        BorderBrush="#E67E22"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="15">

                    <StackPanel>

                        <TextBlock Text="🔧 XİDMƏT SATIŞI"
                                   Foreground="#555555"
                                   FontSize="13"/>

                        <TextBlock Name="txtUmumiXidmetSatisi"
                                   Text="0.00 ₼"
                                   Foreground="#E67E22"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>

                <!-- SATIŞ SAYI -->
                <Border Grid.Column="10"
                        Background="White"
                        BorderBrush="#F39C12"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="15">

                    <StackPanel>

                        <TextBlock Text="🧾 SATIŞ SAYI"
                                   Foreground="#555555"
                                   FontSize="13"/>

                        <TextBlock Name="txtSatisSayi"
                                   Text="0"
                                   Foreground="#F39C12"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>

            </Grid>

            <!-- CƏDVƏLLƏR -->
            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- SATIŞLAR -->
                <Border Grid.Column="0"
                        Background="White"
                        BorderBrush="#D0D0D0"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="📋 SATIŞLAR"
                                   Foreground="Black"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="5,0,0,10"/>

                        <DataGrid x:Name="dgSatislar"
                                  Grid.Row="1"
                                  Margin="10"
                                  AutoGenerateColumns="False"
                                  Background="White"
                                  Foreground="Black"
                                  RowBackground="White"
                                  AlternatingRowBackground="#F2F2F2"
                                  BorderThickness="0"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#D9D9D9"
                                  HeadersVisibility="Column"
                                  FontSize="13">

                            <DataGrid.Resources>

                                <Style TargetType="DataGridColumnHeader">

                                    <Setter Property="Background"
                                            Value="#EEEEEE"/>

                                    <Setter Property="Foreground"
                                            Value="#2E7D32"/>

                                    <Setter Property="FontWeight"
                                            Value="Bold"/>

                                    <Setter Property="Padding"
                                            Value="8,6"/>

                                </Style>

                                <Style TargetType="DataGridCell">

                                    <Setter Property="Foreground"
                                            Value="Black"/>

                                    <Setter Property="Padding"
                                            Value="6"/>

                                </Style>

                            </DataGrid.Resources>

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="№"
                                                    Binding="{Binding Id}"
                                                    Width="Auto"/>

                                <!-- TARİX + SAAT -->
                                <DataGridTextColumn Header="Tarix / Saat"
                                                    Binding="{Binding Tarix, StringFormat='dd.MM.yyyy HH:mm'}"
                                                    Width="150"/>

                                <!-- MƏHSUL -->
                                <DataGridTextColumn Header="Məhsulun adı"
                                                    Binding="{Binding UrunAdi}"
                                                    Width="*"/>

                                <!-- MİQDAR -->
                                <DataGridTextColumn Header="Miqdar"
                                                    Binding="{Binding Miktar}"
                                                    Width="80"/>

                                <!-- ÖDƏNİŞ -->
                                <DataGridTextColumn Header="Ödəniş növü"
                                                    Binding="{Binding OdemeTipi}"
                                                    Width="100"/>

                                <!-- MƏBLƏĞ -->
                                <DataGridTextColumn Header="Ümumi məbləğ"
                                                    Binding="{Binding Toplam, StringFormat='\{0:N2\} ₼'}"
                                                    Width="110"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Grid>

                </Border>

                <!-- ƏN ÇOX SATILAN MƏHSULLAR -->
                <Border Grid.Column="2"
                        Background="White"
                        BorderBrush="#D0D0D0"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="🏆 ƏN ÇOX SATILAN MƏHSULLAR"
                                   Foreground="#F39C12"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="5,0,0,10"/>

                        <DataGrid Grid.Row="1"
                                  Name="dgMehsullar"
                                  AutoGenerateColumns="False"
                                  Background="White"
                                  Foreground="Black"
                                  RowBackground="White"
                                  AlternatingRowBackground="#F2F2F2"
                                  BorderThickness="0"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#D9D9D9"
                                  HeadersVisibility="Column"
                                  FontSize="13">

                            <DataGrid.Resources>

                                <Style TargetType="DataGridColumnHeader">

                                    <Setter Property="Background"
                                            Value="#EEEEEE"/>

                                    <Setter Property="Foreground"
                                            Value="#F39C12"/>

                                    <Setter Property="FontWeight"
                                            Value="Bold"/>

                                    <Setter Property="Padding"
                                            Value="8,6"/>

                                </Style>

                                <Style TargetType="DataGridCell">

                                    <Setter Property="Foreground"
                                            Value="Black"/>

                                    <Setter Property="Padding"
                                            Value="6"/>

                                </Style>

                            </DataGrid.Resources>

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Məhsul"
                                                    Binding="{Binding UrunAdi}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="Miqdar"
                                                    Binding="{Binding Miktar}"
                                                    Width="80"/>

                                <DataGridTextColumn Header="Məbləğ"
                                                    Binding="{Binding Toplam, StringFormat='\{0:N2\} ₼'}"
                                                    Width="100"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Grid>

                </Border>

            </Grid>

        </Grid>

    </Grid>

</Window>
