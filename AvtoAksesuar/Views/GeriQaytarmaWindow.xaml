<Window x:Class="PcKod.UI.Views.GeriQaytarmaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Məhsul Geri Qaytarma"
        Height="700"
        Width="1100"
        MinHeight="650"
        MinWidth="950"
        WindowStartupLocation="CenterOwner"
        Background="#121212">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- BAŞLIQ -->
        <!-- ===================================================== -->

        <Border Grid.Row="0"
                Background="#1E1E1E"
                BorderBrush="#E67E22"
                BorderThickness="1"
                CornerRadius="8"
                Padding="15"
                Margin="0,0,0,12">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <StackPanel>

                    <TextBlock Text="↩ MƏHSUL GERİ QAYTARMA"
                               Foreground="#E67E22"
                               FontSize="24"
                               FontWeight="Bold"/>

                    <TextBlock Text="Çek nömrəsi və ya məhsul adına görə axtararaq məhsulu geri qaytarın."
                               Foreground="#999999"
                               FontSize="14"
                               Margin="0,5,0,0"/>

                </StackPanel>


                <!-- TARİX -->

                <StackPanel Grid.Column="1">

                    <TextBlock Text="Satış tarixi"
                               Foreground="#999999"
                               FontSize="12"
                               Margin="0,0,0,4"/>

                    <DatePicker Name="dpTarix"
                                Width="160"
                                Height="35"
                                SelectedDate="{x:Static sys:DateTime.Today}"
                                SelectedDateChanged="dpTarix_SelectedDateChanged"
                                Background="#252525"
                                Foreground="Black"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ===================================================== -->
        <!-- AXTARIŞ -->
        <!-- ===================================================== -->

        <Border Grid.Row="1"
                Background="#1E1E1E"
                BorderBrush="#333333"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,12">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="110"/>

                </Grid.ColumnDefinitions>


                <!-- ÇEK NÖMRƏSİ -->

                <StackPanel Grid.Column="0"
                            Margin="0,0,8,0">

                    <TextBlock Text="Çek nömrəsi"
                               Foreground="#999999"
                               FontSize="12"
                               Margin="0,0,0,4"/>

                    <TextBox Name="txtCekNomresiAxtar"
                             Height="38"
                             Background="#252525"
                             Foreground="White"
                             BorderBrush="#E67E22"
                             BorderThickness="1"
                             Padding="8"
                             FontSize="15"
                             VerticalContentAlignment="Center"
                             KeyDown="txtAxtaris_KeyDown"/>

                </StackPanel>


                <!-- MƏHSUL ADI -->

                <StackPanel Grid.Column="1"
                            Margin="0,0,12,0">

                    <TextBlock Text="Məhsul adı"
                               Foreground="#999999"
                               FontSize="12"
                               Margin="0,0,0,4"/>

                    <TextBox Name="txtMehsulAxtar"
                             Height="38"
                             Background="#252525"
                             Foreground="White"
                             BorderBrush="#E67E22"
                             BorderThickness="1"
                             Padding="8"
                             FontSize="15"
                             VerticalContentAlignment="Center"
                             KeyDown="txtAxtaris_KeyDown"/>

                </StackPanel>


                <!-- MƏLUMAT -->

                <StackPanel Grid.Column="2"
                            Margin="0,0,8,0">

                    <TextBlock Text="Axtarış"
                               Foreground="#999999"
                               FontSize="12"
                               Margin="0,0,0,4"/>

                    <TextBlock Text="Çek № + Məhsul"
                               Foreground="#E67E22"
                               FontSize="15"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>

                </StackPanel>


                <!-- NƏTİCƏ -->

                <TextBlock Grid.Column="3"
                           Name="txtAxtarisNeticesi"
                           Text="Bütün satışlar"
                           Foreground="#AAAAAA"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="0,20,10,0"/>


                <!-- AXTAR -->

                <Button Grid.Column="4"
                        Name="btnAxtar"
                        Content="🔍 AXTAR"
                        Height="42"
                        Margin="5,15,5,0"
                        Background="#E67E22"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="13"
                        Cursor="Hand"
                        Click="btnAxtar_Click"/>


                <!-- TƏMİZLƏ -->

                <Button Grid.Column="5"
                        Name="btnAxtarTemizle"
                        Content="✖ TƏMİZLƏ"
                        Height="42"
                        Margin="5,15,0,0"
                        Background="#555555"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="12"
                        Cursor="Hand"
                        Click="btnAxtarTemizle_Click"/>

            </Grid>

        </Border>


        <!-- ===================================================== -->
        <!-- SATIŞLAR -->
        <!-- ===================================================== -->

        <Border Grid.Row="2"
                Background="#1E1E1E"
                BorderBrush="#333333"
                BorderThickness="1"
                CornerRadius="8"
                Padding="5">

            <DataGrid Name="dgSatishlar"
                      AutoGenerateColumns="False"
                      Background="#1E1E1E"
                      Foreground="White"
                      RowBackground="#1E1E1E"
                      AlternatingRowBackground="#232323"
                      BorderBrush="#333333"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#333333"
                      VerticalGridLinesBrush="#333333"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      SelectionChanged="dgSatishlar_SelectionChanged"
                      PreviewMouseLeftButtonDown="dgSatishlar_PreviewMouseLeftButtonDown"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column">

                <DataGrid.Resources>

                    <!-- HEADER -->

                    <Style TargetType="DataGridColumnHeader">

                        <Setter Property="Background"
                                Value="#252525"/>

                        <Setter Property="Foreground"
                                Value="#E67E22"/>

                        <Setter Property="FontWeight"
                                Value="Bold"/>

                        <Setter Property="Padding"
                                Value="8"/>

                        <Setter Property="HorizontalContentAlignment"
                                Value="Center"/>

                    </Style>


                    <!-- CELL -->

                    <Style TargetType="DataGridCell">

                        <Setter Property="Foreground"
                                Value="White"/>

                        <Setter Property="Background"
                                Value="Transparent"/>

                        <Setter Property="Padding"
                                Value="7"/>

                        <Setter Property="BorderThickness"
                                Value="0"/>

                    </Style>


                    <!-- ROW -->

                    <Style TargetType="DataGridRow">

                        <Setter Property="Background"
                                Value="#1E1E1E"/>

                        <Setter Property="Foreground"
                                Value="White"/>

                        <Setter Property="Cursor"
                                Value="Hand"/>

                        <Style.Triggers>

                            <Trigger Property="IsSelected"
                                     Value="True">

                                <Setter Property="Background"
                                        Value="#5A3218"/>

                                <Setter Property="Foreground"
                                        Value="White"/>

                            </Trigger>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter Property="Background"
                                        Value="#3A2A20"/>

                                <Setter Property="Foreground"
                                        Value="White"/>

                            </Trigger>

                        </Style.Triggers>

                    </Style>

                </DataGrid.Resources>


                <DataGrid.Columns>


                    <!-- ================================================= -->
                    <!-- ÇEK NÖMRƏSİ -->
                    <!-- ================================================= -->

                    <DataGridTextColumn Header="Çek №"
                                        Binding="{Binding CekNomresi}"
                                        Width="100"/>


                    <!-- ================================================= -->
                    <!-- MƏHSUL -->
                    <!-- ================================================= -->

                    <DataGridTextColumn Header="Məhsul"
                                        Binding="{Binding UrunAdi}"
                                        Width="*"/>


                    <!-- ================================================= -->
                    <!-- MİQDAR -->
                    <!-- ================================================= -->

                    <DataGridTextColumn Header="Satılan miqdar"
                                        Binding="{Binding Miktar, StringFormat={}{0:N2}}"
                                        Width="140"/>


                    <!-- ================================================= -->
                    <!-- MƏBLƏĞ -->
                    <!-- ================================================= -->

                    <DataGridTextColumn Header="Məbləğ"
                                        Binding="{Binding ToplamTutar, StringFormat={}{0:N2} AZN}"
                                        Width="160"/>


                    <!-- ================================================= -->
                    <!-- ÖDƏNİŞ -->
                    <!-- ================================================= -->

                    <DataGridTextColumn Header="Ödəniş"
                                        Binding="{Binding OdemeYontemi}"
                                        Width="120"/>


                    <!-- ================================================= -->
                    <!-- TARİX -->
                    <!-- ================================================= -->

                    <DataGridTextColumn Header="Tarix"
                                        Binding="{Binding TarixMetni}"
                                        Width="145"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>


        <!-- ===================================================== -->
        <!-- AŞAĞI PANEL -->
        <!-- ===================================================== -->

        <Border Grid.Row="3"
                Background="#1E1E1E"
                BorderBrush="#333333"
                BorderThickness="1"
                CornerRadius="8"
                Padding="15"
                Margin="0,12,0,0">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="180"/>

                </Grid.ColumnDefinitions>


                <!-- SEÇİLMİŞ MƏHSUL -->

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="Seçilmiş məhsul:"
                               Foreground="#999999"
                               FontSize="13"/>

                    <TextBlock Name="txtSecilenUrun"
                               Text="-"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,4,0,0"/>

                    <TextBlock Name="txtSecilenCek"
                               Text="Çek №: -"
                               Foreground="#E67E22"
                               FontSize="13"
                               Margin="0,3,0,0"/>

                </StackPanel>


                <!-- MİQDAR -->

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">

                    <TextBlock Text="Geri qaytarılacaq miqdar"
                               Foreground="#999999"
                               FontSize="13"
                               Margin="0,0,0,5"/>

                    <TextBox Name="txtQaytarmaMiqdar"
                             Text="1"
                             Height="40"
                             Background="#252525"
                             Foreground="White"
                             BorderBrush="#E67E22"
                             BorderThickness="1"
                             FontSize="18"
                             Padding="8"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"/>

                </StackPanel>


                <!-- GERİ QAYTAR -->

                <Button Grid.Column="2"
                        Name="btnGeriQaytar"
                        Content="↩ GERİ QAYTAR"
                        Height="50"
                        Margin="15,10,0,0"
                        Background="#E67E22"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="14"
                        Cursor="Hand"
                        Click="btnGeriQaytar_Click"/>

            </Grid>

        </Border>

    </Grid>

</Window>