<Window x:Class="PcKod.UI.Views.GunlukSatislarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Çeklər - Gündəlik Satışlar"
        Height="700"
        Width="1200"
        MinHeight="600"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#121212">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- BAŞLIQ -->
        <!-- ===================================================== -->

        <Border Grid.Row="0"
                Background="#1E1E1E"
                BorderBrush="#00FF41"
                BorderThickness="1"
                CornerRadius="8"
                Padding="15"
                Margin="0,0,0,10">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <StackPanel>

                    <TextBlock Text="🧾 ÇEKLƏR / GÜNDƏLİK SATIŞLAR"
                               Foreground="#00FF41"
                               FontSize="22"
                               FontWeight="Bold"/>

                    <TextBlock Name="txtGun"
                               Foreground="#AAAAAA"
                               FontSize="13"
                               Margin="0,5,0,0"/>

                </StackPanel>


                <Button Grid.Column="1"
                        Name="btnYenile"
                        Content="🔄 YENİLƏ"
                        Width="110"
                        Height="38"
                        Background="#333333"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Click="btnYenile_Click"
                        Cursor="Hand"/>

            </Grid>

        </Border>


        <!-- ===================================================== -->
        <!-- SATIŞLAR -->
        <!-- ===================================================== -->

        <DataGrid Grid.Row="1"
                  Name="dgGunlukSatislar"
                  AutoGenerateColumns="False"
                  Background="#1E1E1E"
                  Foreground="White"
                  RowBackground="#1E1E1E"
                  AlternatingRowBackground="#252525"
                  BorderThickness="0"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#333"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  FontSize="15"
                  CellEditEnding="dgGunlukSatislar_CellEditEnding"
                  SelectionChanged="dgGunlukSatislar_SelectionChanged">

            <DataGrid.Resources>

                <!-- ================================================= -->
                <!-- HEADER -->
                <!-- ================================================= -->

                <Style TargetType="DataGridColumnHeader">

                    <Setter Property="Background"
                            Value="#252525"/>

                    <Setter Property="Foreground"
                            Value="#00FF41"/>

                    <Setter Property="FontWeight"
                            Value="Bold"/>

                    <Setter Property="Padding"
                            Value="10"/>

                    <Setter Property="HorizontalContentAlignment"
                            Value="Center"/>

                </Style>


                <!-- ================================================= -->
                <!-- CELL -->
                <!-- ================================================= -->

                <Style TargetType="DataGridCell">

                    <Setter Property="Foreground"
                            Value="White"/>

                    <Setter Property="Padding"
                            Value="8"/>

                    <Setter Property="Background"
                            Value="Transparent"/>

                    <Setter Property="BorderThickness"
                            Value="0"/>

                </Style>


                <!-- ================================================= -->
                <!-- ROW -->
                <!-- ================================================= -->

                <Style TargetType="DataGridRow">

                    <Setter Property="Background"
                            Value="#1E1E1E"/>

                    <Setter Property="Foreground"
                            Value="White"/>

                    <Style.Triggers>

                        <Trigger Property="IsSelected"
                                 Value="True">

                            <Setter Property="Background"
                                    Value="#3A2630"/>

                            <Setter Property="Foreground"
                                    Value="White"/>

                        </Trigger>

                    </Style.Triggers>

                </Style>

            </DataGrid.Resources>


            <DataGrid.Columns>


                <!-- ================================================= -->
                <!-- № -->
                <!-- ================================================= -->

                <DataGridTextColumn Header="№"
                                    Binding="{Binding Id}"
                                    Width="60"
                                    IsReadOnly="True"/>


                <!-- ================================================= -->
                <!-- TARİX -->
                <!-- ================================================= -->

                <DataGridTextColumn Header="Tarix / Saat"
                                    Binding="{Binding Tarix}"
                                    Width="160"
                                    IsReadOnly="True"/>


                <!-- ================================================= -->
                <!-- MƏHSUL -->
                <!-- ================================================= -->

                <DataGridTextColumn Header="Məhsul"
                                    Binding="{Binding UrunAdi}"
                                    Width="2*"
                                    IsReadOnly="True"/>


                <!-- ================================================= -->
                <!-- MİQDAR -->
                <!-- ================================================= -->

                <DataGridTextColumn Header="Miqdar"
                                    Binding="{Binding Miktar, StringFormat={}{0:N2}}"
                                    Width="100"
                                    IsReadOnly="True"/>


                <!-- ================================================= -->
                <!-- VAHİD -->
                <!-- ================================================= -->

                <DataGridTextColumn Header="Vahid"
                                    Binding="{Binding BirimMetni}"
                                    Width="90"
                                    IsReadOnly="True"/>


                <!-- ================================================= -->
                <!-- VAHİD QİYMƏTİ -->
                <!-- YALNIZ BU SÜTUN DƏYİŞƏ BİLƏR -->
                <!-- ================================================= -->

                <DataGridTextColumn Header="Vahid qiyməti"
                                    Width="140"
                                    IsReadOnly="False">

                    <DataGridTextColumn.Binding>

                        <Binding Path="BirimFiyat"
                                 Mode="TwoWay"
                                 UpdateSourceTrigger="LostFocus"
                                 StringFormat="{}{0:N2}"/>

                    </DataGridTextColumn.Binding>

                </DataGridTextColumn>


                <!-- ================================================= -->
                <!-- ÜMUMİ MƏBLƏĞ -->
                <!-- ================================================= -->

                <DataGridTextColumn Header="Məbləğ"
                                    Binding="{Binding ToplamTutar, StringFormat={}{0:N2} AZN}"
                                    Width="140"
                                    IsReadOnly="True"/>


                <!-- ================================================= -->
                <!-- ÖDƏNİŞ -->
                <!-- ================================================= -->

                <DataGridTextColumn Header="Ödəniş"
                                    Binding="{Binding OdemeYontemi}"
                                    Width="110"
                                    IsReadOnly="True"/>


                <!-- ================================================= -->
                <!-- ÇEK -->
                <!-- ================================================= -->

                <DataGridTemplateColumn Header="Çek"
                                        Width="120">

                    <DataGridTemplateColumn.CellTemplate>

                        <DataTemplate>

                            <Button Content="🧾 ÇEK"
                                    Height="32"
                                    Width="90"
                                    Background="#3498DB"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontWeight="Bold"
                                    Click="btnCek_Click"
                                    Cursor="Hand"/>

                        </DataTemplate>

                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>

            </DataGrid.Columns>

        </DataGrid>


        <!-- ===================================================== -->
        <!-- AŞAĞI PANEL -->
        <!-- ===================================================== -->

        <Border Grid.Row="2"
                Background="#1E1E1E"
                BorderBrush="#333"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,10,0,0">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <!-- ================================================= -->
                <!-- GÜNDƏLİK ÜMUMİ -->
                <!-- ================================================= -->

                <StackPanel>

                    <TextBlock Text="GÜNLÜK ÜMUMİ SATIŞ"
                               Foreground="#A0A0A0"
                               FontSize="12"/>

                    <TextBlock Name="txtGunlukCem"
                               Text="0,00 AZN"
                               Foreground="#00FF41"
                               FontSize="25"
                               FontWeight="Bold"/>

                </StackPanel>


                <!-- ================================================= -->
                <!-- ÇAP -->
                <!-- ================================================= -->

                <Button Grid.Column="1"
                        Name="btnCekCapEt"
                        Content="🖨 SEÇİLMİŞ ÇEKİ ÇAP ET"
                        Width="190"
                        Height="42"
                        Background="#27AE60"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Click="btnCekCapEt_Click"
                        Cursor="Hand"/>

            </Grid>

        </Border>

    </Grid>

</Window>